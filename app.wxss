/* ============================================
   Design System - 室内设计师作品集
   ============================================ */

page {
  --black: #1a1a1a;
  --dark: #2d2d2d;
  --gray-900: #333333;
  --gray-700: #555555;
  --gray-500: #888888;
  --gray-400: #aaaaaa;
  --gray-300: #cccccc;
  --gray-200: #e8e8e8;
  --gray-100: #f5f5f5;
  --white: #ffffff;
  --accent: #c9a96e;
  --accent-light: #f0e6d3;

  --bg: #fafafa;
  --card: #ffffff;
  --border: rgba(0, 0, 0, 0.06);

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);

  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 40rpx;
  --font-2xl: 48rpx;
  --font-3xl: 64rpx;

  background: var(--bg);
  color: var(--black);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

button::after {
  border: none;
}

/* ============================================
   Base Components
   ============================================ */

.container {
  padding: 0 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

.section {
  margin-bottom: 80rpx;
}

.section__header {
  margin-bottom: 32rpx;
}

.section__label {
  display: inline-block;
  font-size: var(--font-xs);
  font-weight: 600;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 12rpx;
}

.section__title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--black);
  line-height: 1.3;
}

.section__desc {
  font-size: var(--font-sm);
  color: var(--gray-500);
  line-height: 1.7;
  margin-top: 12rpx;
}

/* ============================================
   Buttons
   ============================================ */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 48rpx;
  font-size: var(--font-base);
  font-weight: 600;
  border-radius: var(--radius-xl);
  transition: all 0.2s ease;
}

.btn--primary {
  background: var(--black);
  color: var(--white);
}

.btn--secondary {
  background: var(--gray-100);
  color: var(--black);
}

.btn--accent {
  background: var(--accent);
  color: var(--white);
}

.btn--outline {
  background: transparent;
  border: 2rpx solid var(--gray-300);
  color: var(--black);
}

.btn--small {
  height: 64rpx;
  padding: 0 32rpx;
  font-size: var(--font-sm);
  border-radius: var(--radius-lg);
}

/* ============================================
   Tags / Chips
   ============================================ */

.tag {
  display: inline-block;
  padding: 10rpx 20rpx;
  font-size: var(--font-xs);
  font-weight: 500;
  color: var(--gray-700);
  background: var(--gray-100);
  border-radius: var(--radius-sm);
}

.tag--accent {
  background: var(--accent-light);
  color: var(--accent);
}

/* ============================================
   Card
   ============================================ */

.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

/* ============================================
   Utilities
   ============================================ */

.text-accent { color: var(--accent); }
.text-gray { color: var(--gray-500); }
.text-center { text-align: center; }
.mt-sm { margin-top: 16rpx; }
.mt-md { margin-top: 24rpx; }
.mt-lg { margin-top: 40rpx; }
.mb-sm { margin-bottom: 16rpx; }
.mb-md { margin-bottom: 24rpx; }
.mb-lg { margin-bottom: 40rpx; }
