page {
  --ink: #171512;
  --ink-soft: #3d3730;
  --muted: #756b5f;
  --faint: #a99d8e;
  --line: rgba(48, 39, 28, 0.13);
  --bg: #f4f0e8;
  --bg-deep: #e7ded0;
  --paper: #fffaf1;
  --paper-strong: #fbf1df;
  --brass: #a9783d;
  --brass-soft: #ead9bd;
  --olive: #55624b;
  --terracotta: #9b5841;
  --white: #ffffff;

  --radius-sm: 8rpx;
  --radius-md: 14rpx;
  --radius-lg: 18rpx;
  --radius-xl: 28rpx;
  --shadow-soft: 0 18rpx 54rpx rgba(61, 49, 34, 0.1);

  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Serif SC", "Songti SC", sans-serif;
  -webkit-font-smoothing: antialiased;
}

button {
  font-family: inherit;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  background:
    linear-gradient(90deg, rgba(23, 21, 18, 0.035) 1rpx, transparent 1rpx) 0 0 / 92rpx 92rpx,
    linear-gradient(180deg, rgba(169, 120, 61, 0.1), transparent 520rpx),
    var(--bg);
}

.container {
  padding: 0 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 108rpx);
}

.section {
  margin-bottom: 92rpx;
}

.section__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.section__eyebrow,
.section__label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--brass);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.section__title {
  display: block;
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.15;
}

.section__desc {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 84rpx;
  margin: 0;
  padding: 0 34rpx;
  border-radius: var(--radius-sm);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.btn--primary {
  background: var(--ink);
  color: var(--paper);
}

.btn--outline {
  background: rgba(255, 250, 241, 0.52);
  color: var(--ink);
  border: 1rpx solid var(--line);
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(169, 120, 61, 0.24);
  border-radius: var(--radius-sm);
  background: rgba(255, 250, 241, 0.58);
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 48rpx;
}

.card {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  background: rgba(255, 250, 241, 0.82);
  box-shadow: var(--shadow-soft);
}

.link-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 54rpx;
  border-radius: var(--radius-sm);
  background: var(--ink);
  color: var(--paper);
  font-size: 23rpx;
  line-height: 54rpx;
}

.secondary-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 54rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: rgba(255, 250, 241, 0.62);
  color: var(--ink);
  font-size: 23rpx;
  line-height: 54rpx;
}
