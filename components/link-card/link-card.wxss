.link-card {
  padding: 22rpx;
}

.link-card__title {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1b1714;
}

.link-card__url {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a6246;
  word-break: break-all;
}

.link-card__note {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f564d;
}

.link-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.link-card__open {
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
}
