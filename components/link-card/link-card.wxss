.link-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background:
    linear-gradient(135deg, rgba(169, 120, 61, 0.22), transparent 42%),
    var(--ink);
  color: var(--paper);
}

.link-card__head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.link-card__kicker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid rgba(234, 217, 189, 0.45);
  color: var(--brass-soft);
  font-size: 22rpx;
  font-weight: 900;
}

.link-card__title {
  flex: 1;
  color: var(--paper);
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
}

.link-card__note {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 250, 241, 0.78);
  font-size: 24rpx;
  line-height: 1.65;
}

.link-card__url {
  display: block;
  margin-top: 14rpx;
  color: rgba(234, 217, 189, 0.72);
  font-size: 21rpx;
  line-height: 1.5;
  word-break: break-all;
}

.link-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.link-card__actions .secondary-btn {
  border-color: rgba(255, 250, 241, 0.22);
  background: rgba(255, 250, 241, 0.1);
  color: var(--paper);
}

.link-card__open {
  background: var(--brass-soft);
  color: var(--ink);
}
