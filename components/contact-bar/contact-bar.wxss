.contact-bar {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--paper);
  box-shadow: var(--shadow-soft);
}

.contact-bar__title {
  display: block;
  padding: 28rpx 28rpx 4rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.45;
}

.contact-bar__row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx;
}

.contact-bar__row + .contact-bar__row {
  border-top: 1rpx solid var(--line);
}

.contact-bar__main {
  flex: 1;
  min-width: 0;
}

.contact-bar__label {
  display: block;
  margin-bottom: 6rpx;
  color: var(--brass);
  font-size: 22rpx;
  font-weight: 800;
}

.contact-bar__value {
  display: block;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-all;
}

.contact-bar__action {
  flex: 0 0 auto;
}
