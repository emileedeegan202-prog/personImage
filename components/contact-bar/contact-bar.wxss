.contact-bar {
  padding: 0 24rpx;
}

.contact-bar__title {
  display: block;
  padding: 22rpx 0 0;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #1b1714;
}

.contact-bar__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
}

.contact-bar__row + .contact-bar__row {
  border-top: 1rpx solid #e5dbcf;
}

.contact-bar__label {
  flex: 0 0 auto;
  width: 72rpx;
  font-size: 24rpx;
  color: #8a6246;
}

.contact-bar__value {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.5;
  color: #1b1714;
}

.contact-bar__action {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 12rpx;
  height: 48rpx;
  line-height: 48rpx;
}
