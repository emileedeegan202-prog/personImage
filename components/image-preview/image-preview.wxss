.image-preview {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.92);
}

.image-preview__stage {
  position: relative;
  width: 100%;
  height: 100vh;
}

.image-preview__swiper {
  width: 100%;
  height: 100vh;
}

.image-preview__item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-preview__image {
  width: 100%;
  height: 100vh;
}

.image-preview__top {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 44rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}

.image-preview__count {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 24rpx;
}

.image-preview__close {
  pointer-events: auto;
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 24rpx;
}
