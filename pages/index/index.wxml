<view class="page">
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar__brand">
      <text class="nav-bar__mark">GC</text>
      <view class="nav-bar__name">
        <text class="nav-bar__title">{{profile.name}}</text>
        <text class="nav-bar__sub">Interior</text>
      </view>
    </view>
    <scroll-view class="nav-bar__tabs" scroll-x enable-flex>
      <view
        wx:for="{{navItems}}"
        wx:key="id"
        class="nav-tab {{activeNav === item.id ? 'nav-tab--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="scrollTo"
      >
        {{item.label}}
      </view>
    </scroll-view>
    <button class="nav-bar__share" open-type="share" plain="true" hover-class="none">分享</button>
  </view>

  <view class="container">
    <view id="hero" class="hero">
      <view class="hero__copy">
        <text class="hero__eyebrow">INTERIOR PORTFOLIO</text>
        <text class="hero__name">{{profile.name}}</text>
        <text class="hero__role">{{profile.role}} · {{profile.city}}</text>
        <text class="hero__tagline">{{profile.tagline}}</text>
      </view>

      <view class="hero__image-wrap">
        <image class="hero__image" src="{{profile.heroImage}}" mode="aspectFill" />
        <view class="hero__plate">
          <text class="hero__plate-num">01</text>
          <text class="hero__plate-text">住宅空间 / 方案深化 / 落地配合</text>
        </view>
      </view>

      <view class="hero__summary-row">
        <text class="hero__summary">{{profile.summary}}</text>
        <view class="hero__actions">
          <button class="btn btn--primary" data-id="works" bindtap="scrollTo">浏览作品</button>
          <button class="btn btn--outline" data-id="contact" bindtap="scrollTo">联系设计师</button>
        </view>
      </view>

      <view class="hero__tags">
        <text wx:for="{{strengths}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
    </view>

    <view id="works" class="section">
      <view class="section__header">
        <view>
          <text class="section__eyebrow">SELECTED WORKS</text>
          <text class="section__title">精选作品</text>
        </view>
        <text class="section__desc">{{cases.length}} 个项目</text>
      </view>

      <view class="waterfall">
        <view class="waterfall__col" wx:for="{{caseColumns}}" wx:for-item="column" wx:key="id">
          <view
            wx:for="{{column.items}}"
            wx:key="id"
            class="work-card"
            data-id="{{item.id}}"
            bindtap="openCase"
          >
            <image class="work-card__image" src="{{item.coverImage}}" mode="aspectFill" lazy-load />
            <view class="work-card__info">
              <text class="work-card__title">{{item.title}}</text>
              <text class="work-card__meta">{{item.location}} · {{item.type}} · {{item.area}}</text>
              <text class="work-card__summary">{{item.summary}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view id="services" class="section">
      <view class="section__header">
        <view>
          <text class="section__eyebrow">SERVICES</text>
          <text class="section__title">服务内容</text>
        </view>
      </view>

      <view class="service-grid">
        <view wx:for="{{services}}" wx:key="title" class="service-item">
          <text class="service-item__index">{{item.icon}}</text>
          <text class="service-item__title">{{item.title}}</text>
          <text class="service-item__desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view id="process" class="section">
      <view class="section__header">
        <view>
          <text class="section__eyebrow">PROCESS</text>
          <text class="section__title">合作流程</text>
        </view>
      </view>

      <view class="process-list">
        <view wx:for="{{process}}" wx:key="step" class="process-step">
          <text class="process-step__num">{{item.step}}</text>
          <view class="process-step__body">
            <text class="process-step__title">{{item.title}}</text>
            <text class="process-step__desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{links.length > 0}}" class="section">
      <view class="section__header">
        <view>
          <text class="section__eyebrow">VR VIEW</text>
          <text class="section__title">全景预览</text>
        </view>
      </view>

      <link-card
        wx:for="{{links}}"
        wx:key="url"
        title="{{item.title}}"
        url="{{item.url}}"
        note="{{item.note}}"
      />
    </view>

    <view id="contact" class="section">
      <view class="section__header">
        <view>
          <text class="section__eyebrow">CONTACT</text>
          <text class="section__title">联系设计师</text>
        </view>
      </view>

      <contact-bar contact="{{contact}}" title="添加微信，预约空间方案沟通" />

      <view class="footer">
        <text class="footer__text">© {{profile.name}} · {{profile.role}}</text>
      </view>
    </view>
  </view>
</view>
