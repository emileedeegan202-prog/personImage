/* ============================================
   Navigation
   ============================================ */

.nav-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: rgba(250, 250, 250, 0.9);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid var(--border);
}

.nav-bar__logo {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--white);
  background: var(--black);
  border-radius: 50%;
}

.nav-bar__tabs {
  flex: 1;
  margin: 0 24rpx;
  white-space: nowrap;
}

.nav-tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: var(--font-sm);
  color: var(--gray-500);
  transition: all 0.2s;
}

.nav-tab--active {
  color: var(--black);
  font-weight: 600;
}

.nav-bar__share {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: var(--font-sm);
  color: var(--gray-700);
  background: var(--gray-100);
  border-radius: var(--radius-lg);
}

/* ============================================
   Hero
   ============================================ */

.hero {
  padding: 80rpx 0 60rpx;
}

.hero__badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--accent);
  background: var(--accent-light);
  border-radius: var(--radius-sm);
  margin-bottom: 24rpx;
}

.hero__name {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--black);
  line-height: 1.1;
  margin-bottom: 16rpx;
}

.hero__tagline {
  font-size: var(--font-lg);
  color: var(--gray-700);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.hero__summary {
  font-size: var(--font-base);
  color: var(--gray-500);
  line-height: 1.8;
  margin-bottom: 32rpx;
}

.hero__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.hero__actions {
  display: flex;
  gap: 20rpx;
}

.hero__actions .btn {
  flex: 1;
}

/* ============================================
   Waterfall Layout
   ============================================ */

.waterfall {
  display: flex;
  gap: 20rpx;
}

.waterfall__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.work-card {
  cursor: pointer;
  transition: transform 0.2s;
}

.work-card:active {
  transform: scale(0.98);
}

.work-card__image {
  width: 100%;
  display: block;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.work-card__info {
  padding: 24rpx;
}

.work-card__title {
  display: block;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--black);
  margin-bottom: 8rpx;
}

.work-card__meta {
  display: block;
  font-size: var(--font-sm);
  color: var(--gray-500);
}

/* ============================================
   Services
   ============================================ */

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.service-item {
  padding: 32rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.service-item__icon {
  display: block;
  font-size: var(--font-2xl);
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 16rpx;
}

.service-item__title {
  display: block;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--black);
  margin-bottom: 8rpx;
}

.service-item__desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--gray-500);
  line-height: 1.6;
}

/* ============================================
   Process Timeline
   ============================================ */

.process-timeline {
  position: relative;
}

.process-step {
  position: relative;
  padding-left: 48rpx;
  padding-bottom: 40rpx;
}

.process-step:last-child {
  padding-bottom: 0;
}

.process-step__dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--accent);
  border-radius: 50%;
}

.process-step__line {
  position: absolute;
  left: 7rpx;
  top: 28rpx;
  width: 2rpx;
  height: calc(100% - 16rpx);
  background: var(--gray-200);
}

.process-step__content {
  padding: 0 0 0 16rpx;
}

.process-step__step {
  display: block;
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--accent);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.process-step__title {
  display: block;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--black);
  margin-bottom: 4rpx;
}

.process-step__desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--gray-500);
}

/* ============================================
   Link Banner
   ============================================ */

.link-banner {
  padding: 32rpx;
  background: linear-gradient(135deg, var(--black) 0%, var(--dark) 100%);
}

.link-banner__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link-banner__title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--white);
}

.link-banner__action {
  font-size: var(--font-sm);
  color: var(--accent);
}

/* ============================================
   Contact
   ============================================ */

.contact-card {
  margin-bottom: 40rpx;
}

.contact-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.contact-card__row:last-child {
  border-bottom: none;
}

.contact-card__info {
  flex: 1;
}

.contact-card__label {
  display: block;
  font-size: var(--font-xs);
  color: var(--gray-500);
  margin-bottom: 4rpx;
}

.contact-card__value {
  display: block;
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--black);
}

.contact-card__action {
  font-size: var(--font-sm);
  color: var(--accent);
  font-weight: 500;
}

/* ============================================
   Footer
   ============================================ */

.footer {
  padding: 40rpx 0;
  text-align: center;
}

.footer__text {
  font-size: var(--font-xs);
  color: var(--gray-400);
}
