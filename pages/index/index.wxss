.nav-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(48, 39, 28, 0.11);
  background: rgba(244, 240, 232, 0.92);
  backdrop-filter: blur(24px);
}

.nav-bar__brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 0 0 auto;
}

.nav-bar__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid var(--ink);
  background: var(--ink);
  color: var(--paper);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.nav-bar__name {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.nav-bar__title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.1;
}

.nav-bar__sub {
  color: var(--faint);
  font-size: 18rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.nav-bar__tabs {
  flex: 1;
  white-space: nowrap;
}

.nav-tab {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 18rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.nav-tab--active {
  color: var(--ink);
  font-weight: 800;
}

.nav-bar__share {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 18rpx;
  height: 52rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: rgba(255, 250, 241, 0.68);
  color: var(--ink);
  font-size: 23rpx;
  line-height: 52rpx;
}

.hero {
  padding: 54rpx 0 88rpx;
}

.hero__copy {
  position: relative;
  z-index: 2;
}

.hero__eyebrow {
  display: block;
  margin-bottom: 14rpx;
  color: var(--brass);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.hero__name {
  display: block;
  color: var(--ink);
  font-size: 92rpx;
  font-weight: 900;
  line-height: 1;
}

.hero__role {
  display: block;
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  font-weight: 700;
}

.hero__tagline {
  display: block;
  max-width: 640rpx;
  margin-top: 30rpx;
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
}

.hero__image-wrap {
  position: relative;
  height: 620rpx;
  margin-top: 42rpx;
  overflow: hidden;
  border-radius: var(--radius-xl);
  background: var(--bg-deep);
  box-shadow: var(--shadow-soft);
}

.hero__image {
  width: 100%;
  height: 100%;
}

.hero__plate {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 250, 241, 0.5);
  background: rgba(23, 21, 18, 0.72);
  backdrop-filter: blur(16px);
}

.hero__plate-num {
  color: var(--brass-soft);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.hero__plate-text {
  flex: 1;
  color: var(--paper);
  font-size: 24rpx;
  line-height: 1.5;
}

.hero__summary-row {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 34rpx;
}

.hero__summary {
  color: var(--muted);
  font-size: 27rpx;
  line-height: 1.85;
}

.hero__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.hero__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.waterfall {
  display: flex;
  gap: 20rpx;
}

.waterfall__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  min-width: 0;
}

.work-card {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--paper);
  box-shadow: 0 12rpx 36rpx rgba(61, 49, 34, 0.08);
}

.work-card:active {
  transform: scale(0.985);
}

.work-card__image {
  width: 100%;
  height: 410rpx;
  background: var(--bg-deep);
}

.work-card__info {
  padding: 22rpx;
}

.work-card__title {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.work-card__meta {
  display: block;
  margin-top: 8rpx;
  color: var(--brass);
  font-size: 22rpx;
  font-weight: 700;
}

.work-card__summary {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.service-item {
  min-height: 238rpx;
  padding: 26rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: rgba(255, 250, 241, 0.78);
}

.service-item__index {
  display: block;
  margin-bottom: 28rpx;
  color: var(--brass);
  font-size: 28rpx;
  font-weight: 900;
}

.service-item__title {
  display: block;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 800;
}

.service-item__desc {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.65;
}

.process-list {
  border-top: 1rpx solid var(--line);
}

.process-step {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.process-step__num {
  flex: 0 0 70rpx;
  color: var(--brass);
  font-size: 30rpx;
  font-weight: 900;
}

.process-step__body {
  flex: 1;
}

.process-step__title {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
}

.process-step__desc {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.footer {
  padding: 52rpx 0 10rpx;
  text-align: center;
}

.footer__text {
  color: var(--faint);
  font-size: 22rpx;
}
