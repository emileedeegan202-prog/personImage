.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.topbar__name {
  display: block;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #1b1714;
}

.topbar__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #7a6f64;
}

.topbar__share {
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.nav-pills {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 18rpx;
}

.nav-pill {
  margin: 0 12rpx 12rpx 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #efe5d7;
  color: #3f362f;
  font-size: 24rpx;
}

.hero {
  display: flex;
  flex-direction: column;
}

.hero__copy {
  padding: 28rpx;
}

.hero__title {
  display: block;
  margin-top: 10rpx;
  font-size: 56rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #1b1714;
}

.hero__role {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #8a6246;
}

.hero__desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #5f564d;
}

.hero__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.hero__btn {
  margin: 0;
  padding: 0 24rpx;
  height: 68rpx;
  line-height: 68rpx;
}

.hero__chips {
  margin-top: 18rpx;
}

.hero__visual {
  padding: 0 28rpx 28rpx;
}

.showcase {
  position: relative;
  min-height: 300rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #2f2a25 0%, #6f4e39 48%, #b58a62 100%);
}

.showcase__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.showcase::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(26, 21, 18, 0.08) 0%, rgba(26, 21, 18, 0.48) 100%);
  z-index: 0;
}

.showcase::after {
  content: "";
  position: absolute;
  inset: 18rpx;
  border: 1rpx solid rgba(255, 248, 240, 0.38);
  border-radius: 12rpx;
  z-index: 1;
}

.showcase__frame {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  display: flex;
  flex-direction: column;
  z-index: 2;
}

.showcase__label {
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: rgba(255, 248, 240, 0.78);
}

.showcase__title {
  display: block;
  margin-top: 8rpx;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #fff8f0;
}

.showcase__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 248, 240, 0.78);
}

.hero__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.stat {
  padding: 18rpx 14rpx;
  border-radius: 16rpx;
  background: #f4ece1;
  border: 1rpx solid #e0d4c6;
}

.stat__value {
  display: block;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #1b1714;
}

.stat__label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6f655b;
}

.about-card {
  padding: 0 24rpx;
}

.about-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
}

.about-card__row--stack {
  align-items: flex-start;
}

.about-card__label {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: #8a6246;
}

.about-card__value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  line-height: 1.7;
  color: #1b1714;
}

.about-card__value--long {
  max-width: 78%;
}

.case-card {
  margin-bottom: 18rpx;
}

.case-card__visual {
  position: relative;
  min-height: 260rpx;
  padding: 22rpx;
  overflow: hidden;
}

.case-card__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.case-card__visual::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(24, 18, 14, 0.06) 0%, rgba(24, 18, 14, 0.42) 100%);
}

.case-card__visual::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 82rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.18);
  z-index: 1;
}

.tone-terracotta {
  background: linear-gradient(135deg, #261d19 0%, #7f5539 56%, #d2a679 100%);
}

.tone-sage {
  background: linear-gradient(135deg, #1f2a25 0%, #587166 56%, #aebcb4 100%);
}

.tone-ink {
  background: linear-gradient(135deg, #15120f 0%, #49413b 56%, #b0a396 100%);
}

.case-card__badge {
  position: relative;
  z-index: 1;
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 240, 0.18);
  color: #fff8f0;
  font-size: 20rpx;
}

.case-card__visual-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 90rpx;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #fff8f0;
}

.case-card__visual-subtitle {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 248, 240, 0.84);
}

.case-card__body {
  padding: 24rpx;
}

.case-card__title {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1b1714;
}

.case-card__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a6246;
}

.case-card__summary {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #5f564d;
}

.case-card__points {
  margin-top: 18rpx;
}

.case-point + .case-point {
  margin-top: 14rpx;
}

.case-point__label {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
  color: #8a6246;
}

.case-point__text {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #39312b;
}

.case-card__footer {
  margin-top: 18rpx;
}

.link-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.link-card {
  padding: 22rpx;
}

.link-card__title {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1b1714;
}

.link-card__url {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a6246;
  word-break: break-all;
}

.link-card__note {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f564d;
}

.link-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.link-card__open {
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.video-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.video-card {
  overflow: hidden;
}

.video-card__image {
  width: 100%;
  height: 320rpx;
  display: block;
}

.video-card__body {
  padding: 22rpx;
}

.video-card__title {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1b1714;
}

.video-card__path {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a6246;
}

.video-card__note {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f564d;
}

.video-card__actions {
  margin-top: 16rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.grid-card {
  padding: 22rpx;
}

.grid-card__title {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1b1714;
}

.grid-card__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f564d;
}

.process-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.process-item {
  padding: 22rpx;
}

.process-item__step {
  display: block;
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: #8a6246;
}

.process-item__title {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1b1714;
}

.process-item__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f564d;
}

.contact-card {
  padding: 0 24rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
}

.contact-row__label {
  flex: 0 0 auto;
  width: 72rpx;
  font-size: 24rpx;
  color: #8a6246;
}

.contact-row__value {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.5;
  color: #1b1714;
}

.contact-row__action {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 12rpx;
  height: 48rpx;
  line-height: 48rpx;
}
