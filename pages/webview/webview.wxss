.fallback {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  background: var(--bg);
}

.fallback__title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--black);
  margin-bottom: 12rpx;
}

.fallback__desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--gray-500);
}
