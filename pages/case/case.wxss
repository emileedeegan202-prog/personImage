.detail-hero {
  overflow: hidden;
}

.detail-hero__visual {
  position: relative;
  min-height: 380rpx;
  padding: 28rpx;
  overflow: hidden;
}

.detail-hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.detail-hero__visual::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(24, 18, 14, 0.08) 0%, rgba(24, 18, 14, 0.42) 100%);
}

.detail-hero__visual::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 50%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.18);
  z-index: 1;
}

.detail-hero__badge {
  position: relative;
  z-index: 1;
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 240, 0.18);
  color: #fff8f0;
  font-size: 20rpx;
}

.detail-hero__title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 120rpx;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #fff8f0;
}

.detail-hero__meta {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 248, 240, 0.82);
}

.detail-hero__body {
  padding: 24rpx;
}

.detail-hero__summary {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #453d35;
}

.detail-hero__tags {
  margin-top: 16rpx;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.detail-block {
  padding: 22rpx;
}

.detail-block__label {
  display: block;
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  color: #8a6246;
}

.detail-block__text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #1b1714;
}

.gallery {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.gallery-item {
  position: relative;
  min-height: 220rpx;
  padding: 22rpx;
  color: #fff8f0;
  overflow: hidden;
}

.gallery-item__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.gallery-item::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(24, 18, 14, 0.08) 0%, rgba(24, 18, 14, 0.42) 100%);
}

.gallery-item__label {
  display: block;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 700;
  position: relative;
  z-index: 1;
}

.gallery-item__note {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 248, 240, 0.82);
  position: relative;
  z-index: 1;
}

.video-inline {
  overflow: hidden;
}

.video-inline__player {
  width: 100%;
  height: 420rpx;
  display: block;
  background: #000;
}

.video-inline__body {
  padding: 22rpx;
}

.video-inline__title {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1b1714;
}

.video-inline__note {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f564d;
}

.contact-cta {
  padding: 22rpx;
}

.contact-cta__title {
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #1b1714;
}

.contact-cta__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.contact-cta__label {
  flex: 0 0 auto;
  width: 72rpx;
  font-size: 24rpx;
  color: #8a6246;
}

.contact-cta__value {
  flex: 1;
  font-size: 26rpx;
  color: #1b1714;
}

.contact-cta__action {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 12rpx;
  height: 48rpx;
  line-height: 48rpx;
}

.image-preview {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.92);
}

.image-preview__stage {
  position: relative;
  width: 100%;
  height: 100vh;
}

.image-preview__swiper {
  width: 100%;
  height: 100vh;
}

.image-preview__item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-preview__image {
  width: 100%;
  height: 100vh;
}

.image-preview__top {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 44rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}

.image-preview__count {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 24rpx;
}

.image-preview__close {
  pointer-events: auto;
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 24rpx;
}
