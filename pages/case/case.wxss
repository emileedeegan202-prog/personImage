.case-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 0 18rpx;
}

.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0;
}

.back-btn__arrow {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.back-btn__text {
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 700;
}

.case-top__mark {
  color: var(--faint);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.case-header {
  padding: 28rpx 0 34rpx;
}

.case-header__eyebrow {
  display: block;
  margin-bottom: 16rpx;
  color: var(--brass);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.case-header__title {
  display: block;
  color: var(--ink);
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1.12;
}

.case-header__meta {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.case-header__meta text {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  color: var(--ink-soft);
  font-size: 23rpx;
  font-weight: 700;
}

.case-cover {
  position: relative;
  height: 760rpx;
  margin: 0 -12rpx 58rpx;
  overflow: hidden;
  border-radius: var(--radius-xl);
  background: var(--bg-deep);
  box-shadow: var(--shadow-soft);
}

.case-cover__image {
  width: 100%;
  height: 100%;
}

.case-cover__hint {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 250, 241, 0.42);
  background: rgba(23, 21, 18, 0.68);
  color: var(--paper);
  font-size: 22rpx;
}

.case-section {
  margin-bottom: 70rpx;
}

.case-section__label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--brass);
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.case-section__title {
  display: block;
  margin-bottom: 24rpx;
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.case-section__lead {
  display: block;
  padding: 34rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.55;
}

.analysis-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.analysis-item {
  padding: 30rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: rgba(255, 250, 241, 0.78);
}

.analysis-item--dark {
  border-color: var(--ink);
  background: var(--ink);
}

.analysis-item__label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--brass);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.analysis-item--dark .analysis-item__label {
  color: var(--brass-soft);
}

.analysis-item__text {
  display: block;
  color: var(--muted);
  font-size: 27rpx;
  line-height: 1.75;
}

.analysis-item--dark .analysis-item__text {
  color: var(--paper);
}

.gallery-waterfall {
  display: flex;
  gap: 16rpx;
}

.gallery-waterfall__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.gallery-item {
  overflow: hidden;
  border-radius: var(--radius-md);
  background: var(--bg-deep);
}

.gallery-item:active {
  opacity: 0.86;
}

.gallery-item__image {
  display: block;
  width: 100%;
}
