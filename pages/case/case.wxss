/* ============================================
   Back Button
   ============================================ */

.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  margin-bottom: 24rpx;
}

.back-btn__arrow {
  font-size: var(--font-lg);
  color: var(--black);
}

.back-btn__text {
  font-size: var(--font-sm);
  color: var(--gray-700);
}

/* ============================================
   Case Header
   ============================================ */

.case-header {
  padding: 40rpx 0;
}

.case-header__badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-light);
  border-radius: var(--radius-sm);
  margin-bottom: 20rpx;
}

.case-header__title {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--black);
  line-height: 1.2;
  margin-bottom: 12rpx;
}

.case-header__meta {
  font-size: var(--font-md);
  color: var(--gray-500);
}

/* ============================================
   Case Cover
   ============================================ */

.case-cover {
  margin: 0 -32rpx;
  margin-bottom: 48rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.case-cover__image {
  width: 100%;
  display: block;
}

/* ============================================
   Case Sections
   ============================================ */

.case-section {
  margin-bottom: 56rpx;
}

.case-section__label {
  display: block;
  font-size: var(--font-xs);
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--accent);
  margin-bottom: 12rpx;
}

.case-section__title {
  display: block;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--black);
  margin-bottom: 24rpx;
}

.case-section__content {
  display: block;
  font-size: var(--font-base);
  color: var(--gray-700);
  line-height: 1.8;
}

/* ============================================
   Analysis Grid
   ============================================ */

.analysis-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.analysis-item {
  padding: 28rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.analysis-item__label {
  display: block;
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.analysis-item__text {
  display: block;
  font-size: var(--font-base);
  color: var(--gray-700);
  line-height: 1.8;
}

/* ============================================
   Gallery Waterfall
   ============================================ */

.gallery-waterfall {
  display: flex;
  gap: 16rpx;
}

.gallery-waterfall__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gallery-item {
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--gray-100);
}

.gallery-item:active {
  opacity: 0.9;
}

.gallery-item__image {
  width: 100%;
  display: block;
}

/* ============================================
   Link Banner
   ============================================ */

.link-banner {
  padding: 32rpx;
  background: linear-gradient(135deg, var(--black) 0%, var(--dark) 100%);
}

.link-banner__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link-banner__title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--white);
}

.link-banner__action {
  font-size: var(--font-sm);
  color: var(--accent);
}

/* ============================================
   Contact
   ============================================ */

.contact-card {
  border-radius: var(--radius-lg);
}

.contact-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.contact-card__row:last-child {
  border-bottom: none;
}

.contact-card__info {
  flex: 1;
}

.contact-card__label {
  display: block;
  font-size: var(--font-xs);
  color: var(--gray-500);
  margin-bottom: 4rpx;
}

.contact-card__value {
  display: block;
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--black);
}

.contact-card__action {
  font-size: var(--font-sm);
  color: var(--accent);
  font-weight: 500;
}
