<view class="page">
  <view class="shell" wx:if="{{caseItem}}">
    <view class="detail-hero card">
      <view class="detail-hero__visual {{caseItem.toneClass}}" data-src="{{caseItem.coverImage}}" bindtap="previewImage">
        <image wx:if="{{caseItem.coverImage}}" class="detail-hero__image" src="{{caseItem.coverImage}}" mode="aspectFill" />
        <text class="detail-hero__badge">{{caseItem.type}}</text>
        <text class="detail-hero__title">{{caseItem.title}}</text>
        <text class="detail-hero__meta">{{caseItem.area}} · {{caseItem.stage}}</text>
      </view>

      <view class="detail-hero__body">
        <text class="detail-hero__summary">{{caseItem.summary}}</text>
        <view class="detail-hero__tags">
          <view class="chip">{{profile.role}}</view>
          <view class="chip">{{profile.city}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section__head">
        <text class="section__kicker">案例拆解</text>
        <text class="section__title">把项目关键动作讲清楚</text>
      </view>

      <view class="detail-grid">
        <view class="detail-block card">
          <text class="detail-block__label">问题</text>
          <text class="detail-block__text">{{caseItem.challenge}}</text>
        </view>
        <view class="detail-block card">
          <text class="detail-block__label">动作</text>
          <text class="detail-block__text">{{caseItem.move}}</text>
        </view>
        <view class="detail-block card">
          <text class="detail-block__label">结果</text>
          <text class="detail-block__text">{{caseItem.result}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section__head">
        <text class="section__kicker">图片</text>
        <text class="section__title">点击图片可前后翻看</text>
      </view>

      <view class="gallery">
        <view wx:for="{{caseItem.gallery}}" wx:key="label" class="gallery-item card {{caseItem.toneClass}}" data-src="{{item.src}}" bindtap="previewImage">
          <image wx:if="{{item.src}}" class="gallery-item__image" src="{{item.src}}" mode="aspectFill" />
          <text class="gallery-item__label">{{item.label}}</text>
          <text class="gallery-item__note">{{item.note}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section__head">
        <text class="section__kicker">视频</text>
        <text class="section__title">{{caseItem.title}} 对应视频</text>
      </view>

      <view wx:if="{{caseItem.videoFile}}" class="video-inline card">
        <video
          class="video-inline__player"
          src="{{caseItem.videoFile}}"
          controls
          show-center-play-btn="true"
          show-play-btn="true"
          enable-progress-gesture="true"
          objectFit="contain"
        ></video>
        <view class="video-inline__body">
          <text class="video-inline__title">{{caseItem.videoTitle}}</text>
          <text class="video-inline__note">{{caseItem.videoNote}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section__head">
        <text class="section__kicker">效果图</text>
        <text class="section__title">外部链接</text>
      </view>

      <view class="link-grid">
        <view wx:for="{{kujialeLinks}}" wx:key="title" class="link-card card">
          <text class="link-card__title">{{item.title}}</text>
          <text class="link-card__url">{{item.url}}</text>
          <text class="link-card__note">{{item.note}}</text>
          <view class="link-card__actions">
            <button class="link-btn" plain="true" hover-class="none" data-src="{{item.url}}" bindtap="copyLink">复制链接</button>
            <button class="secondary-btn link-card__open" plain="true" hover-class="none" data-src="{{item.url}}" bindtap="openLink">打开预览</button>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="contact-cta card">
        <text class="contact-cta__title">觉得合适，可以直接联系</text>
        <view wx:if="{{contact.wechat}}" class="contact-cta__row">
          <text class="contact-cta__label">微信</text>
          <text class="contact-cta__value">{{contact.wechat}}</text>
          <button class="link-btn contact-cta__action" plain="true" hover-class="none" data-value="{{contact.wechat}}" bindtap="copyText">复制</button>
        </view>
      </view>
    </view>

    <view wx:if="{{previewOpen}}" class="image-preview" bindtap="closePreview">
      <view class="image-preview__stage" catchtap="stopPreviewTap">
        <swiper
          class="image-preview__swiper"
          current="{{previewIndex}}"
          circular="true"
          bindchange="onPreviewChange"
        >
          <swiper-item wx:for="{{previewImages}}" wx:key="*this" class="image-preview__item">
            <image class="image-preview__image" src="{{item}}" mode="aspectFit" />
          </swiper-item>
        </swiper>
        <view class="image-preview__top">
          <text class="image-preview__count">{{previewIndex + 1}} / {{previewImages.length}}</text>
          <button class="image-preview__close" plain="true" hover-class="none" bindtap="closePreview">关闭</button>
        </view>
      </view>
    </view>
  </view>
</view>
