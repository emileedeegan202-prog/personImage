<view class="page">
  <view class="container" wx:if="{{caseItem}}">
    <view class="case-top">
      <view class="back-btn" bindtap="goBack">
        <text class="back-btn__arrow">←</text>
        <text class="back-btn__text">返回</text>
      </view>
      <text class="case-top__mark">{{profile.name}}</text>
    </view>

    <view class="case-header">
      <text class="case-header__eyebrow">PROJECT / {{caseItem.location}}</text>
      <text class="case-header__title">{{caseItem.title}}</text>
      <view class="case-header__meta">
        <text>{{caseItem.type}}</text>
        <text>{{caseItem.area}}</text>
      </view>
    </view>

    <view class="case-cover" data-src="{{caseItem.coverImage}}" bindtap="previewImage">
      <image class="case-cover__image" src="{{caseItem.coverImage}}" mode="aspectFill" />
      <view class="case-cover__hint">
        <text>点击查看大图</text>
      </view>
    </view>

    <view class="case-section">
      <text class="case-section__label">OVERVIEW</text>
      <text class="case-section__lead">{{caseItem.summary}}</text>
    </view>

    <view class="case-section">
      <text class="case-section__label">DESIGN NOTES</text>
      <text class="case-section__title">案例拆解</text>

      <view class="analysis-grid">
        <view class="analysis-item">
          <text class="analysis-item__label">需求</text>
          <text class="analysis-item__text">{{caseItem.challenge}}</text>
        </view>
        <view class="analysis-item">
          <text class="analysis-item__label">策略</text>
          <text class="analysis-item__text">{{caseItem.move}}</text>
        </view>
        <view class="analysis-item analysis-item--dark">
          <text class="analysis-item__label">结果</text>
          <text class="analysis-item__text">{{caseItem.result}}</text>
        </view>
      </view>
    </view>

    <view class="case-section">
      <text class="case-section__label">GALLERY</text>
      <text class="case-section__title">空间图集</text>

      <view class="gallery-waterfall">
        <view class="gallery-waterfall__col" wx:for="{{galleryColumns}}" wx:for-item="column" wx:key="id">
          <view
            wx:for="{{column.items}}"
            wx:key="src"
            class="gallery-item"
            data-src="{{item.src}}"
            bindtap="previewImage"
          >
            <image class="gallery-item__image" src="{{item.src}}" mode="widthFix" lazy-load />
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{caseItem.links.length > 0}}" class="case-section">
      <text class="case-section__label">VR VIEW</text>
      <text class="case-section__title">全景预览</text>
      <link-card
        wx:for="{{caseItem.links}}"
        wx:key="url"
        title="{{item.title}}"
        url="{{item.url}}"
        note="{{item.note}}"
      />
    </view>

    <view class="case-section">
      <text class="case-section__label">CONTACT</text>
      <text class="case-section__title">预约沟通</text>
      <contact-bar contact="{{contact}}" title="喜欢这个项目的尺度和质感？可以从这里开始聊。" />
    </view>
  </view>
</view>
